+	struct pwm_chip *pc = dev_get_drvdata(dev);
+	struct sunxi_pwm_chip *chip = to_sunxi_pwm_chip(pc);
+	unsigned int i;
+	ssize_t len = 0;
+
+	for (i = 0; i < pc->npwm; i++)
