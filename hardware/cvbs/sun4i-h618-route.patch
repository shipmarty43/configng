diff --git a/drivers/gpu/drm/sun4i/sun8i_tcon_top.c b/drivers/gpu/drm/sun4i/sun8i_tcon_top.c
index 8adda57..daf8b3b 100644
--- a/drivers/gpu/drm/sun4i/sun8i_tcon_top.c
+++ b/drivers/gpu/drm/sun4i/sun8i_tcon_top.c
@@ -121,6 +121,67 @@ static struct clk_hw *sun8i_tcon_top_register_gate(struct device *dev,
 				    bit, 0, lock);
 };
 
+/* H618 boot profiles can give TV0 exclusively to its native deflicker.
+ * The pin and CCF gate must see the same parent, including the TVE divider.
+ * The TOP bus is on and its gates are still closed during component bind.
+ */
+static struct clk_hw *sun8i_tcon_top_register_tv0(struct device *dev,
+						  struct sun8i_tcon_top *top)
+{
+	struct device_node *tcon, *tve, *hdmi;
+	struct clk_hw *pixel;
+	struct clk *module;
+	const char *name;
+	bool cvbs;
+	u32 val;
+	int ret;
+
+	if (!of_device_is_compatible(dev->of_node, "allwinner,sun50i-h616-tcon-top"))
+		goto ccu_parent;
+
+	tcon = of_graph_get_remote_node(dev->of_node, 1, 2);
+	tve = tcon ? of_graph_get_remote_node(tcon, 1, 0) : NULL;
+	cvbs = of_device_is_compatible(tve, "allwinner,sun50i-h618-tv-encoder");
+	of_node_put(tve);
+	of_node_put(tcon);
+
+	val = readl(top->regs + TCON_TOP_TCON_TV_SETUP_REG);
+	if (!cvbs) {
+		writel(val & ~TCON_TOP_TV0_CLK_FROM_TVE,
+		       top->regs + TCON_TOP_TCON_TV_SETUP_REG);
+		goto ccu_parent;
+	}
+
+	hdmi = of_graph_get_remote_node(dev->of_node, 5, 0);
+	if (hdmi) {
+		of_node_put(hdmi);
+		return ERR_PTR(dev_err_probe(dev, -EBUSY,
+					     "TV0 is shared with enabled HDMI\n"));
+	}
+
+	module = devm_clk_get(dev, "tve0");
+	if (IS_ERR(module))
+		return ERR_CAST(module);
+	if (clk_get_rate(module) != 216000000)
+		return ERR_PTR(dev_err_probe(dev, -ERANGE, "TVE0 requires 216 MHz\n"));
+	pixel = devm_clk_hw_register_fixed_factor_parent_hw(dev, "tv0-tve-pixel",
+			__clk_get_hw(module), 0, 1, 8);
+	if (IS_ERR(pixel))
+		return pixel;
+	ret = of_property_read_string_index(dev->of_node, "clock-output-names", 0, &name);
+	if (ret)
+		return ERR_PTR(ret);
+
+	writel(val | TCON_TOP_TV0_CLK_FROM_TVE, top->regs + TCON_TOP_TCON_TV_SETUP_REG);
+	return clk_hw_register_gate_parent_hw(dev, name, pixel, 0,
+			top->regs + TCON_TOP_GATE_SRC_REG, TCON_TOP_TCON_TV0_GATE,
+			0, &top->reg_lock);
+
+ccu_parent:
+	return sun8i_tcon_top_register_gate(dev, "tcon-tv0", top->regs,
+			&top->reg_lock, TCON_TOP_TCON_TV0_GATE, 0);
+}
+
 static int sun8i_tcon_top_bind(struct device *dev, struct device *master,
 			       void *data)
 {
@@ -182,19 +243,8 @@ static int sun8i_tcon_top_bind(struct device *dev, struct device *master,
 	writel(0, regs + TCON_TOP_PORT_SEL_REG);
 	writel(0, regs + TCON_TOP_GATE_SRC_REG);
 
-	/*
-	 * TCON TOP has two muxes, which select parent clock for each TCON TV
-	 * channel clock. Parent could be either TCON TV or TVE clock. For now
-	 * we leave this fixed to TCON TV, since TVE driver for R40 is not yet
-	 * implemented. Once it is, graph needs to be traversed to determine
-	 * if TVE is active on each TCON TV. If it is, mux should be switched
-	 * to TVE clock parent.
-	 */
-	i = 0;
-	clk_data->hws[CLK_TCON_TOP_TV0] =
-		sun8i_tcon_top_register_gate(dev, "tcon-tv0", regs,
-					     &tcon_top->reg_lock,
-					     TCON_TOP_TCON_TV0_GATE, i++);
+	clk_data->hws[CLK_TCON_TOP_TV0] = sun8i_tcon_top_register_tv0(dev, tcon_top);
+	i = 1;
 
 	if (quirks->has_tcon_tv1)
 		clk_data->hws[CLK_TCON_TOP_TV1] =
