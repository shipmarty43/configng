+/*
+ * Full-range RGB to limited-range BT.601, from Allwinner DE330 r2y[0]
+ * (Copyright 2017 Allwinner). Three input offsets, then three Q17 rows,
+ * each followed by its 10-bit output offset, in hardware register order.
+ */
+static const u32 de33_rgb_to_yuv601[] = {
+	0, 0, 0,
+	0x0000837a, 0x0001021d, 0x00003221, 0x040,
+	0xffffb41c, 0xffff6b03, 0x0000e0e1, 0x200,
+	0x0000e0e1, 0xffff43b1, 0xffffdb6e, 0x200,
+};
+
+bool sun8i_de33_is_composite(const struct drm_crtc_state *state)
+{
+	struct drm_encoder *encoder;
+
+	drm_for_each_encoder_mask(encoder, state->crtc->dev, state->encoder_mask)
+		if (encoder->encoder_type == DRM_MODE_ENCODER_TVDAC)
+			return true;
+	return false;
+}
