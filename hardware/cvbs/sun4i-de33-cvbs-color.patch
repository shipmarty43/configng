+static void sun8i_de33_set_blend_space(struct regmap *regs, u32 base, bool composite)
+{
+	u32 black = composite ? 0xff108080 : SUN8I_MIXER_BLEND_COLOR_BLACK;
+
+	regmap_update_bits(regs, SUN8I_MIXER_BLEND_OUTCTL(base), GENMASK(9, 8),
+			   composite ? BIT(8) : 0);
+	regmap_write(regs, SUN8I_MIXER_BLEND_BKCOLOR(base), black);
+	regmap_write(regs, SUN8I_MIXER_BLEND_ATTR_FCOLOR(base, 0), black);
+}
