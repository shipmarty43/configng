+static ssize_t header_pwm_profiles_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct sunxi_pwm_chip *chip = dev_get_drvdata(dev);
+	unsigned int i;
+	ssize_t len = 0;
+
+	for (i = 0; i < chip->pwm_chip.npwm; i++)
+		len += sysfs_emit_at(buf, len, "%u %u %u %u\n", i, chip->config[i].bind_pwm,
+				     chip->config[i].dead_time, chip->config[i].pulse_count);
+	return len;
+}
+static DEVICE_ATTR_RO(header_pwm_profiles);
+
+/* Read hardware completion, even when the entire burst fit in one scheduler tick. */
+static ssize_t pulse_busy_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct sunxi_pwm_chip *chip = dev_get_drvdata(dev);
+	u32 busy = 0;
+	unsigned int i;
+
+	for (i = 0; i < chip->pwm_chip.npwm; i++)
+		if (chip->config[i].pulse_count &&
+		    (sunxi_pwm_readl(&chip->pwm_chip, chip->data->pcr_base_offset +
+				     i * chip->data->pwm_reg_uniform_offset) & BIT(10)))
+			busy |= BIT(i);
+	return sysfs_emit(buf, "0x%x\n", busy);
+}
+static DEVICE_ATTR_RO(pulse_busy);
