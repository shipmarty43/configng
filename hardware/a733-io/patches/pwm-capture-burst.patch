+/* The capture IRQ state is shared by the chip. Arm one input and unwind the
+ * IRQ, gate, pinctrl and supply on success, signal and timeout alike. */
+static int sunxi_pwm_capture_a733(struct sunxi_pwm_chip *chip, struct pwm_device *pwm,
+				  struct pwm_capture *result, unsigned long timeout)
+{
+	struct pwm_chip *pc = pwm->chip;
+	unsigned int n = pwm->hwpwm, shift = 2 * n, mask = 3U << shift;
+	u32 ccr = chip->data->ccr_base_offset + n * chip->data->pwm_reg_uniform_offset;
+	u32 pcr = chip->data->pcr_base_offset + n * chip->data->pwm_reg_uniform_offset;
+	struct platform_device *child;
+	struct device_node *np;
+	unsigned long flags;
+	u32 clock, prescale, prev_gate;
+	u64 divisor, rate, start_ns;
+	long wait;
+	int ret;
+
+	if (chip->irq < 0 || pwm->state.enabled ||
+	    chip->config[n].bind_pwm != SUNXI_PWM_BIND_DEFAULT ||
+	    chip->group_config[n].group_channel || chip->config[n].pulse_count)
+		return -EINVAL;
+	if (mutex_lock_interruptible(&chip->capture_lock))
+		return -ERESTARTSYS;
+	np = of_parse_phandle(pc->dev->of_node, "sunxi-pwms", n);
+	child = np ? of_find_device_by_node(np) : NULL;
+	of_node_put(np);
+	ret = -ENODEV;
+	if (!child)
+		goto unlock;
+	ret = sunxi_pwm_regulator_request(chip, &child->dev, n);
+	if (ret)
+		goto put;
+	ret = sunxi_pwm_regulator_enable(chip, n);
+	if (ret)
+		goto put;
+	ret = sunxi_pwm_pin_set_state(&child->dev, PWM_PIN_STATE_ACTIVE);
+	if (ret)
+		goto disable;
+
+	spin_lock_irqsave(&chip->lock, flags);
+	reinit_completion(&chip->capture_done);
+	chip->capture_channel = n;
+	chip->capture_edge = 0;
+	chip->capture_error = 0;
+	clock = sunxi_pwm_readl(pc, sunxi_pwm_regs[n / 2]);
+	prescale = sunxi_pwm_readl(pc, pcr) & 255;
+	start_ns = ktime_get_ns();
+	prev_gate = sunxi_pwm_readl(pc, PWM_PCGR) & BIT(n);
+	sunxi_pwm_set_reg(pc, PWM_PCGR, n, 1, 1);
+	sunxi_pwm_writel(pc, PWM_CISR, mask);
+	sunxi_pwm_writel(pc, ccr, PWM_CAPTURE_EXCLUDE_CFTE_EN_CLEAR);
+	sunxi_pwm_set_reg(pc, PWM_CIER, shift, 2, 3);
+	sunxi_pwm_set_reg(pc, PWM_CER, n, 1, 1);
+	spin_unlock_irqrestore(&chip->lock, flags);
+	wait = wait_for_completion_interruptible_timeout(&chip->capture_done, msecs_to_jiffies(timeout));
+
+	spin_lock_irqsave(&chip->lock, flags);
+	sunxi_pwm_set_reg(pc, PWM_CIER, shift, 2, 0);
+	sunxi_pwm_set_reg(pc, PWM_CER, n, 1, 0);
+	sunxi_pwm_writel(pc, ccr, PWM_CAPTURE_CRLF | PWM_CAPTURE_CFLF);
+	sunxi_pwm_writel(pc, PWM_CISR, mask);
+	sunxi_pwm_set_reg(pc, PWM_PCGR, n, 1, !!prev_gate);
+	chip->capture_channel = -1;
+	spin_unlock_irqrestore(&chip->lock, flags);
+	ret = wait <= 0 ? (wait ? wait : -ETIMEDOUT) : chip->capture_error;
+	if (!ret) {
+		rate = clock & BIT(PWM_CLK_SRC_SHIFT) ? 100000000 : 24000000;
+		divisor = (1ULL << (clock & 15)) * (prescale + 1);
+		/* Bound the result before narrowing the PWM core's u32 nanoseconds. */
+		if (clock != sunxi_pwm_readl(pc, sunxi_pwm_regs[n / 2]) ||
+		    prescale != (sunxi_pwm_readl(pc, pcr) & 255))
+			ret = -EAGAIN;
+		else if ((clock & 15) > 8 || ktime_get_ns() - start_ns >=
+			 div64_u64(65536ULL * divisor * NSEC_PER_SEC, rate))
+			ret = -ERANGE;
+		else if (divisor * (chip->high_ticks + chip->low_ticks) > div_u64(U32_MAX * rate, NSEC_PER_SEC))
+			ret = -ERANGE;
+		else {
+			result->duty_cycle = div64_u64(chip->high_ticks * divisor * NSEC_PER_SEC, rate);
+			result->period = div64_u64((chip->high_ticks + chip->low_ticks) * divisor * NSEC_PER_SEC, rate);
+		}
+	}
+	if (sunxi_pwm_pin_set_state(&child->dev, PWM_PIN_STATE_SLEEP) && !ret)
+		ret = -EIO;
+disable:
+	sunxi_pwm_regulator_disable(chip, n);
+put:
+	put_device(&child->dev);
+unlock:
+	mutex_unlock(&chip->capture_lock);
+	return ret;
+}
