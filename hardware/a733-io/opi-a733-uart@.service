[Unit]
Description=Restore Orange Pi Zero 3W UART framing on %I
BindsTo=dev-%i.device
After=dev-%i.device
ConditionPathExistsGlob=/etc/armbian-config/a733-uart/uart*.json

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/share/armbian-config/a733_uart.py restore %I
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
UMask=0077
