+/* Import the storage already handed to the client before the first decode.
+ * Experimental path: single-planar linear NV12 H.264 only. Keep independent fd
+ * ownership in the queue slot, including when a surface is destroyed. */
+static int capture_import_backing(struct v4l2r_context *ctx,
+				  struct v4l2r_surface *surface, int index)
+{
+	struct v4l2r_capture_buffer *capture = &ctx->captures[index];
+	struct v4l2r_surface_backing *backing = surface->backing;
+	const struct v4l2_pix_format *fmt = &ctx->capture_format.fmt.pix;
+	int fd;
+
+	if (!backing || backing->pixelformat != fmt->pixelformat ||
+	    backing->nb_planes != 1 || backing->width != fmt->width ||
+	    backing->height != fmt->height || backing->pitch != fmt->bytesperline ||
+	    backing->plane_size[0] < fmt->sizeimage) {
+		v4l2r_log("pre-export backing does not match CAPTURE layout\n");
+		return -EINVAL;
+	}
+	fd = fcntl(backing->dmabuf_fd[0], F_DUPFD_CLOEXEC, 0);
+	if (fd < 0)
+		return -errno;
+	if (capture->map[0]) {
+		munmap(capture->map[0], capture->plane_size[0]);
+		capture->map[0] = NULL;
+	}
+	if (capture->dmabuf_fd[0] >= 0)
+		close(capture->dmabuf_fd[0]);
+	capture->dmabuf_fd[0] = fd;
+	capture->plane_size[0] = backing->plane_size[0];
+	capture->nb_planes = 1;
+	return 0;
 }
 
