/dts-v1/;
/plugin/;
&{/} {
    compatible = "linux,dummy-virt", "xunlong,orangepi-zero2w", "allwinner,sun50i-h618";
    soc {
        compatible = "simple-bus"; #address-cells = <2>; #size-cells = <2>; ranges;
        i2c1: i2c@5002400 {
            compatible = "test,dfr0528-adapter"; reg = <0 0x5002400 0 0x400>;
            #address-cells = <1>; #size-cells = <0>; status = "okay";
        };
        pwm@300a000 {
            compatible = "test,h616-pwm", "allwinner,sun50i-h616-pwm";
            reg = <0 0x300a000 0 0x400>; #pwm-cells = <3>; status = "okay";
        };
        pinctrl@300b000 {
            reg = <0 0x300b000 0 0x400>;
            pwm_pins: pwm1-pi-pin { pins = "PI11"; function = "pwm1"; };
        };
        pwm1@0300a000 { status = "okay"; pinctrl-0 = <&pwm_pins>; };
    };
};
